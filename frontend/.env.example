# Optional: for local dev if you want to override the backend target used by Vite's dev proxy.
# The docker entrypoint sets BACKEND_URL automatically.
BACKEND_URL=http://127.0.0.1:8080

# Required for authenticated API calls (most /api/v1 endpoints).
# In the single-container setup this is provided automatically.
BACKEND_API_KEY=replace-me

# -----------------------------
# Frontend authentication (Better Auth)
# -----------------------------

# Public origin for redirects/callbacks (Docker entrypoint sets this to http://localhost:3000)
ORIGIN=http://localhost:3000

# Secret for signing/encrypting auth cookies.
# Docker entrypoint sets AUTH_SECRET from FRONTEND_AUTH_SECRET.
AUTH_SECRET=replace-me

# SQLite file path (or filename) for the frontend auth DB.
# Docker entrypoint defaults this to /riven/data/frontend/riven.db
DATABASE_URL=./riven.db

# Optional: create the first admin user on startup (only when the DB has 0 users)
RIVEN_ADMIN_USERNAME=admin
RIVEN_ADMIN_EMAIL=admin@example.com
RIVEN_ADMIN_PASSWORD=replace-me

# Credential signups are disabled by default.
# Set ENABLE_EMAIL_PASSWORD_SIGNUP=true to allow self-serve registration.
ENABLE_EMAIL_PASSWORD_SIGNUP=false

# Plex OAuth (PIN-based) via Better Auth generic OAuth plugin
PLEX_CLIENT_ID=riven
ENABLE_PLEX_SIGNUP=false

# Optional: override Vite dev server port (default 3000)
PORT=3000
